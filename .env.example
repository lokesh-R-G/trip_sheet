# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ========================================================
# Database Configuration
# ========================================================

# Trip Sheet application database (Primary PostgreSQL)
# Used by the Trip Sheet backend and Prisma Client
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/TRIP_SHEET_DB?schema=public"

# TLCM Pro database — REFERENCE CONFIGURATION ONLY.
# CRITICAL: Do NOT use this URL for direct cross-database queries or writes.
# Trip Sheet communicates with TLCM Pro exclusively via the backend REST API.
TLCM_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/TLCM_PRO_DB?schema=public"

# TLCM Pro backend API — configure when the actual API URL is known.
TLCM_API_BASE_URL="http://localhost:4000/api/v1"

# Application environment
NODE_ENV="development"
PORT=5000
